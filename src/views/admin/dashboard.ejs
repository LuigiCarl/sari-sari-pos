<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="page-heading"><div><h1>Dashboard</h1><p class="muted">Here’s how your store is doing today.</p></div></div>
  <div class="quick-actions">
    <a href="/admin/products" class="btn btn-primary">+ Add product</a>
    <a href="/admin/sales" class="btn btn-secondary">View sales</a>
  </div>

  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Today’s sales</div>
      <div class="stat-value"><%= peso(todayTotal.total) %></div>
      <div class="stat-sub"><%= todayTotal.count %> transaction<%= todayTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Last 7 days</div>
      <div class="stat-value"><%= peso(weekTotal.total) %></div>
      <div class="stat-sub"><%= weekTotal.count %> transaction<%= weekTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">This month</div>
      <div class="stat-value"><%= peso(monthTotal.total) %></div>
      <div class="stat-sub"><%= monthTotal.count %> transaction<%= monthTotal.count === 1 ? '' : 's' %></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="section-heading">
        <div>
          <h2>Sales Trend (7 days)</h2>
          <p class="data-status" id="salesChartStatus">Loading live data…</p>
        </div>
        <button type="button" class="btn btn-small btn-secondary" id="refreshSalesChart">Refresh</button>
      </div>
      <div class="chart-wrap"><canvas id="salesTrendChart" height="220"></canvas></div>
    </div>

    <div class="card">
      <h2>Top Products (30 days)</h2>
      <% if (topProducts.length === 0) { %>
        <p class="muted">No sales recorded yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
          <tbody>
            <% topProducts.forEach(p => { %>
              <tr>
                <td><%= p.product_name %></td>
                <td><%= p.units_sold %></td>
                <td><%= peso(p.revenue) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Low Stock Alerts</h2>
      <% if (lowStock.length === 0) { %>
        <p class="muted">All products are sufficiently stocked.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
          <tbody>
            <% lowStock.forEach(p => { %>
              <tr class="<%= p.stock_quantity === 0 ? 'row-danger' : 'row-warning' %>">
                <td><%= p.name %></td>
                <td><%= p.stock_quantity %> <%= p.unit %></td>
                <td><%= p.reorder_level %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h2>Recent Transactions</h2>
      <% if (recentSales.length === 0) { %>
        <p class="muted">No transactions yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>When</th></tr></thead>
          <tbody>
            <% recentSales.forEach(s => { %>
              <tr>
                <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
                <td><%= s.cashier %></td>
                <td><%= peso(s.total_amount) %></td>
                <td><%= s.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  const ctx = document.getElementById('salesTrendChart');
  const status = document.getElementById('salesChartStatus');
  let salesChart;

  function renderSalesChart(data) {
    if (salesChart) salesChart.destroy();
    salesChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: data.labels.map(day => day.slice(5)),
      datasets: [{
        label: 'Sales (₱)',
        data: data.totals,
        borderColor: '#16805c',
        backgroundColor: 'rgba(22, 128, 92, 0.15)',
        tension: 0.3,
        fill: true,
      }],
    },
    options: {
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } },
    },
    });
  }

  async function loadSalesChart() {
    status.textContent = 'Loading live data…';
    try {
      const response = await fetch('/admin/api/sales-chart?days=7', {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Request failed (${response.status})`);
      renderSalesChart(await response.json());
      status.textContent = `Updated ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    } catch (error) {
      status.textContent = 'Unable to load live sales data.';
      console.error('Could not load sales chart:', error);
    }
  }

  document.getElementById('refreshSalesChart').addEventListener('click', loadSalesChart);
  loadSalesChart();
</script>
<%- include('../partials/foot') %>
