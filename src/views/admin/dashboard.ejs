<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container dashboard-page">
  <div class="dashboard-heading">
    <div class="dashboard-title">
      <div class="dashboard-copy">
        <h1>Dashboard</h1>
        <p class="muted">Here’s how your store is doing today.</p>
      </div>
    </div>
    <a href="/admin/sales" class="btn btn-primary">View sales</a>
  </div>

  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Today’s net sales</div>
      <div class="stat-value"><%= peso(todayTotal.total) %></div>
      <div class="stat-sub"><%= todayTotal.count %> transaction<%= todayTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Last 7 days · net sales</div>
      <div class="stat-value"><%= peso(weekTotal.total) %></div>
      <div class="stat-sub"><%= weekTotal.count %> transaction<%= weekTotal.count === 1 ? '' : 's' %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">This month · net sales</div>
      <div class="stat-value"><%= peso(monthTotal.total) %></div>
      <div class="stat-sub"><%= monthTotal.count %> transaction<%= monthTotal.count === 1 ? '' : 's' %></div>
    </div>
  </div>

  <div class="grid-2 dashboard-grid dashboard-overview">
    <div class="card">
      <div class="section-heading">
        <div>
          <h2>Net Sales Trend <span class="muted" id="salesRangeLabel">(Last 7 days)</span></h2>
          <p class="data-status" id="salesChartStatus">Loading live data…</p>
        </div>
        <button type="button" class="btn btn-small btn-secondary" id="refreshSalesChart">Refresh</button>
      </div>
      <div class="chart-range" role="group" aria-label="Sales chart date range">
        <button type="button" class="category-filter" data-sales-range="today" aria-pressed="false">Today</button>
        <button type="button" class="category-filter active" data-sales-range="week" aria-pressed="true">Last 7 days</button>
        <button type="button" class="category-filter" data-sales-range="month" aria-pressed="false">This month</button>
      </div>
      <div class="chart-wrap"><canvas id="salesTrendChart" aria-label="Sales for the last seven days" role="img"></canvas></div>
    </div>

    <div class="card">
      <h2>Top Products (30 days)</h2>
      <% if (topProducts.length === 0) { %>
        <p class="muted">No sales recorded yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
          <tbody>
            <% topProducts.forEach(p => { %>
              <tr>
                <td><%= p.product_name %></td>
                <td><%= p.units_sold %></td>
                <td><%= peso(p.revenue) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="grid-2 dashboard-grid dashboard-activity">
    <div class="card">
      <div class="section-heading"><h2>Low Stock Alerts</h2><a href="/admin/products" class="card-link">Manage stock</a></div>
      <% if (lowStock.length === 0) { %>
        <div class="dashboard-empty">
          <span class="empty-check" aria-hidden="true">&#10003;</span>
          <strong>Stock levels look good</strong>
          <p class="muted">All products are sufficiently stocked.</p>
        </div>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
          <tbody>
            <% lowStock.forEach(p => { %>
              <tr class="<%= p.stock_quantity === 0 ? 'row-danger' : 'row-warning' %>">
                <td><%= p.name %></td>
                <td><%= p.stock_quantity %> <%= p.unit %></td>
                <td><%= p.reorder_level %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <div class="section-heading"><h2>Recent Transactions</h2><a href="/admin/sales" class="card-link">View all</a></div>
      <% if (recentSales.length === 0) { %>
        <p class="muted">No transactions yet.</p>
      <% } else { %>
        <table class="table transactions-table">
          <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>When</th></tr></thead>
          <tbody>
            <% recentSales.forEach(s => { %>
              <tr>
                <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
                <td><%= s.cashier %></td>
                <td><%= peso(s.total_amount) %></td>
                <td class="transaction-date">
                  <span><%= new Date(s.created_at).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  <small class="muted"><%= new Date(s.created_at).toLocaleTimeString('en-PH', { timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit' }) %></small>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</main>

<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  const ctx = document.getElementById('salesTrendChart');
  const status = document.getElementById('salesChartStatus');
  let salesChart;
  let selectedRange = 'week';
  let chartRequest;

  function renderSalesChart(data) {
    if (salesChart) salesChart.destroy();
    salesChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: data.labels.map(day => day.slice(5)),
      datasets: [{
        label: 'Sales (₱)',
        data: data.totals,
        borderColor: '#16805c',
        backgroundColor: 'rgba(22, 128, 92, 0.15)',
        tension: 0.3,
        fill: true,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } },
    },
    });
  }

  async function loadSalesChart() {
    if (chartRequest) chartRequest.abort();
    chartRequest = new AbortController();
    const signal = chartRequest.signal;
    status.textContent = 'Loading live data…';
    try {
      const response = await fetch(`/admin/api/sales-chart?range=${selectedRange}`, {
        signal,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Request failed (${response.status})`);
      renderSalesChart(await response.json());
      status.textContent = `Updated ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    } catch (error) {
      if (error.name === 'AbortError') return;
      status.textContent = 'Unable to load live sales data.';
      console.error('Could not load sales chart:', error);
    }
  }

  document.getElementById('refreshSalesChart').addEventListener('click', loadSalesChart);
  document.querySelectorAll('[data-sales-range]').forEach(button => button.addEventListener('click', () => {
    selectedRange = button.dataset.salesRange;
    document.querySelectorAll('[data-sales-range]').forEach(item => {
      item.classList.toggle('active', item === button);
      item.setAttribute('aria-pressed', String(item === button));
    });
    const label = button.textContent;
    document.getElementById('salesRangeLabel').textContent = `(${label})`;
    ctx.setAttribute('aria-label', `Sales: ${label}`);
    loadSalesChart();
  }));
  loadSalesChart();
</script>
<%- include('../partials/foot') %>
