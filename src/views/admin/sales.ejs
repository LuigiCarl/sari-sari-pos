<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Sales Transactions</h1>

  <div class="card">
    <form method="GET" action="/admin/sales" class="form-inline">
      <label>From <input type="date" name="from" value="<%= from %>" /></label>
      <label>To <input type="date" name="to" value="<%= to %>" /></label>
      <button type="submit" class="btn btn-secondary">Filter</button>
      <a href="/admin/sales" class="btn btn-small">Clear</a>
      <button type="button" class="btn btn-small" data-export-table="salesTable" data-export-name="sales.csv">Export CSV</button>
    </form>
  </div>

  <div class="card">
    <% if (sales.length === 0) { %>
      <p class="muted">No transactions found.</p>
    <% } else { %>
      <table class="table" id="salesTable">
        <thead><tr><th>Receipt</th><th>Cashier</th><th>Total</th><th>Paid</th><th>Change</th><th>When</th></tr></thead>
        <tbody>
          <% sales.forEach(s => { %>
            <tr>
              <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
              <td><%= s.cashier %></td>
              <td><%= peso(s.total_amount) %></td>
              <td><%= peso(s.amount_paid) %></td>
              <td><%= peso(s.change_amount) %></td>
              <td><%= s.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
