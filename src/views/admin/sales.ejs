<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Sales Transactions</h1>

  <div class="card">
    <form method="GET" action="/admin/sales" class="form-inline">
      <label>From <input type="date" name="from" value="<%= from %>" /></label>
      <label>To <input type="date" name="to" value="<%= to %>" /></label>
      <button type="submit" class="btn btn-secondary">Filter</button>
      <a href="/admin/sales" class="btn btn-small">Clear</a>
      <button type="button" class="btn btn-small" data-export-table="salesTable" data-export-name="sales.csv">Export CSV</button>
    </form>
  </div>

  <div class="card">
    <% if (sales.length === 0) { %>
      <p class="muted">No transactions found.</p>
    <% } else { %>
      <div class="table-scroll"><table class="table" id="salesTable">
        <thead><tr><th>Receipt</th><th>Cashier</th><th>Original sale</th><th>Refunded</th><th>Net sale</th><th>Status</th><th>When</th></tr></thead>
        <tbody>
          <% sales.forEach(s => { %>
            <tr>
              <td><a href="/admin/sales/<%= s.id %>"><%= s.receipt_no %></a></td>
              <td><%= s.cashier %></td>
              <td><%= peso(s.total_amount) %></td>
              <td><%= peso(s.refunded_amount) %></td>
              <td><%= peso(s.net_amount) %></td>
              <td><%= s.voided_at ? 'Voided' : Number(s.refunded_amount) > 0 ? 'Refunded' : 'Completed' %></td>
              <td><%= new Date(s.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
