<%- include('partials/head') %>
<div class="login-page">
  <form method="POST" action="/register" class="login-card">
    <img src="/images/logo.png" alt="Sari-Sari POS Logo" class="login-logo" />
    <h1> Sari-Sari POS</h1>
    <p class="muted">Create an account</p>
    <% if (flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

    <label>Full Name
      <input type="text" name="full_name" required autofocus />
    </label>
    <label>Username
      <input type="text" name="username" required />
    </label>
    <label>Password
      <input type="password" name="password" required minlength="6" />
    </label>
    <label>Confirm Password
      <input type="password" name="confirm_password" required minlength="6" />
    </label>
    <label>Account Type
      <select name="role" id="roleSelect">
        <option value="sales_rep">Sales Representative (Cashier)</option>
        <% if (adminSignupEnabled) { %><option value="admin">Admin</option><% } %>
      </select>
    </label>
    <label id="adminCodeField" hidden>Admin Setup Code
      <input type="text" name="admin_code" id="adminCodeInput" autocomplete="off" />
    </label>
    <% if (!adminSignupEnabled) { %>
      <p class="muted" style="font-size: 0.8rem; margin: -0.5rem 0 0;">
        Admin self-registration is currently disabled. New admins must be created from the Admin &gt; Users page.
      </p>
    <% } %>

    <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    <p class="muted" style="text-align: center; margin: 0;">
      Already have an account? <a href="/login">Login</a>
    </p>
  </form>
</div>
<script>
  const roleSelect = document.getElementById('roleSelect');
  const adminCodeField = document.getElementById('adminCodeField');
  const adminCodeInput = document.getElementById('adminCodeInput');
  function syncAdminCodeField() {
    const isAdmin = roleSelect.value === 'admin';
    adminCodeField.hidden = !isAdmin;
    adminCodeInput.required = isAdmin;
  }
  roleSelect.addEventListener('change', syncAdminCodeField);
  syncAdminCodeField();
</script>
<%- include('partials/foot') %>
