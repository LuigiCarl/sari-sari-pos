<%- include('partials/head') %>
<div class="login-page">
  <form method="POST" action="/login" class="login-card">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="auth-brand">
      <img src="/images/logo.png" alt="Sari-Sari POS logo" class="auth-logo" />
      <span class="auth-brand-name">Sari-Sari <strong>POS</strong></span>
    </div>
    <h1>Welcome back</h1>
    <p class="muted">Sign in to manage your store.</p>
    <% if (flash && flash.error) { %>
      <div class="alert alert-error" role="alert"><%= flash.error %></div>
    <% } %>
    <label>Username
      <input type="text" name="username" autofocus required />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <button type="submit" class="btn btn-primary btn-block">Login</button>
    <p class="muted auth-footer">No account yet? <a href="/register">Register</a></p>
  </form>
</div>
<%- include('partials/foot') %>
