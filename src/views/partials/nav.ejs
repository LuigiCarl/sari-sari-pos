<header class="topbar">
  <button type="button" class="btn btn-secondary mobile-menu" aria-expanded="false" aria-controls="mainNavigation">Menu</button>
  <a href="/" class="topbar-brand">
    <img src="/images/logo.png" alt="" class="brand-logo" />
    <span>Sari-Sari <strong>POS</strong></span>
  </a>
  <nav class="topbar-nav" id="mainNavigation" aria-label="Main navigation">
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/products">Products</a>
      <a href="/admin/sales">Sales</a>
      <a href="/admin/inventory-reports">Inventory Reports</a>
      <a href="/admin/users">Users</a>
    <% } else if (currentUser && currentUser.role === 'sales_rep') { %>
      <a href="/pos">Point of Sale</a>
      <a href="/pos/inventory">Inventory</a>
    <% } %>
  </nav>
  <div class="topbar-user">
    <% if (currentUser) { %>
      <span><%= currentUser.fullName %></span>
      <span class="user-role"><%= currentUser.role === 'admin' ? 'Admin' : 'Sales Rep' %></span>
      <form method="POST" action="/logout" class="inline-form">
        <button type="submit" class="link-button">Logout</button>
      </form>
    <% } %>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" /></svg></button>
  </div>
</header>
<% if (flash && flash.success) { %><div class="alert alert-success" role="status"><%= flash.success %></div><% } %>
<% if (flash && flash.error) { %><div class="alert alert-error" role="alert"><%= flash.error %></div><% } %>
