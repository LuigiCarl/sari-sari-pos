<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container pos-layout">
  <div class="pos-products">
    <div class="page-heading"><div><h1>Point of Sale</h1><p class="muted">Tap a product to add it to the cart.</p></div><span class="keyboard-hint">⌘ K to search</span></div>
    <input type="search" id="productSearch" placeholder="Search product or scan barcode..." autofocus />
    <div class="category-filters" id="categoryFilters">
      <button type="button" class="category-filter active" data-category="all">All products</button>
      <% [...new Set(products.map(p => p.category_name).filter(Boolean))].forEach(category => { %>
        <button type="button" class="category-filter" data-category="<%= category %>"><%= category %></button>
      <% }) %>
    </div>
    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          <%= p.stock_quantity <= 0 ? 'disabled' : '' %>
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
          data-category="<%= p.category_name || '' %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-stock stock-badge <%= p.stock_quantity <= 0 ? 'stock-out' : p.stock_quantity <= p.reorder_level ? 'stock-low' : 'stock-good' %>"><%= p.stock_quantity <= 0 ? 'Out of stock' : p.stock_quantity + ' ' + p.unit + ' left' %></span>
        </button>
      <% }) %>
    </div>
  </div>

  <div class="pos-cart">
    <div class="cart-heading"><h2>Cart</h2><span class="cart-count" id="cartCount">0 items</span></div>
    <button type="button" class="btn btn-small btn-secondary" id="clearCart" disabled>Clear Cart</button>
    <table class="table" id="cartTable">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
      <tbody id="cartBody"></tbody>
    </table>
    <p class="muted" id="cartEmpty">Your cart is empty. Select a product to begin.</p>
    <div class="cart-total">Total: <span id="cartTotal">₱0.00</span></div>

    <form method="POST" action="/pos/checkout" id="checkoutForm" data-user-id="<%= currentUser.id %>">
      <input type="hidden" name="items" id="itemsInput" />
      <input type="hidden" name="checkout_token" value="<%= checkoutToken %>" />
      <p class="data-status" id="cartRecoveryStatus" role="status"></p>
      <label>Amount Paid
        <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" required />
      </label>
      <div class="cart-change">Change: <span id="changeAmount">₱0.00</span></div>
      <p id="paymentStatus" class="data-status payment-status" role="status" aria-live="polite"></p>
      <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Complete Sale</button>
    </form>
  </div>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>
