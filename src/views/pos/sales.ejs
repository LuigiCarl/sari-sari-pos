<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="page-heading"><div><h1>My Sales</h1><p class="muted">Your latest 100 transactions. Open a receipt to view or print it again.</p></div><a href="/pos" class="btn btn-primary">New Sale</a></div>
  <div class="card">
    <% if (sales.length === 0) { %>
      <p class="muted">No sales yet. Completed transactions will appear here.</p>
    <% } else { %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Your sales history">
        <table class="table">
          <thead><tr><th>Receipt</th><th>Date</th><th>Total</th><th>Action</th></tr></thead>
          <tbody><% sales.forEach(sale => { %>
            <tr>
              <td><a href="/pos/receipt/<%= sale.id %>"><%= sale.receipt_no %></a></td>
              <td><%= new Date(sale.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= peso(sale.total_amount) %></td>
              <td><a href="/pos/receipt/<%= sale.id %>" class="btn btn-small btn-secondary">View receipt</a></td>
            </tr>
          <% }) %></tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
