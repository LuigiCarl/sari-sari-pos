<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="page-heading"><div><h1>My Sales</h1><p class="muted">Browse your transactions. Open a receipt to view or print it again.</p></div><a href="/pos" class="btn btn-primary">New Sale</a></div>
  <div class="card">
    <form method="GET" action="/pos/sales" class="form-inline sales-filters">
      <label>Receipt<input type="search" name="q" value="<%= filters.search %>" placeholder="Search receipt..." /></label>
      <label>From<input type="date" name="from" value="<%= filters.from %>" /></label>
      <label>To<input type="date" name="to" value="<%= filters.to %>" /></label>
      <button type="submit" class="btn btn-primary">Filter</button><a href="/pos/sales" class="btn btn-secondary">Reset</a>
    </form>
    <% if (sales.length === 0) { %>
      <div class="dashboard-empty"><strong>No sales found</strong><p class="muted">Completed transactions appear here. Adjust your filters or start a new sale.</p><a href="/pos" class="btn btn-primary">New Sale</a></div>
    <% } else { %>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Your sales history">
        <table class="table">
          <thead><tr><th>Receipt</th><th>Date</th><th>Original total</th><th>Status</th><th>Action</th></tr></thead>
          <tbody><% sales.forEach(sale => { %>
            <tr>
              <td><a href="/pos/receipt/<%= sale.id %>"><%= sale.receipt_no %></a></td>
              <td><%= new Date(sale.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= peso(sale.total_amount) %></td>
              <td><%= sale.voided_at ? 'Voided' : Number(sale.refunded_amount) > 0 ? 'Refunded' : 'Completed' %></td>
              <td><a href="/pos/receipt/<%= sale.id %>" class="btn btn-small btn-secondary">View receipt</a></td>
            </tr>
          <% }) %></tbody>
        </table>
      </div>
    <% } %>
    <nav class="sales-pagination" aria-label="Sales pages">
      <% if (pagination.previous) { %><a href="<%= pagination.previous %>" class="btn btn-secondary">Previous</a><% } %>
      <span class="muted">Page <%= pagination.page %></span>
      <% if (pagination.next) { %><a href="<%= pagination.next %>" class="btn btn-secondary">Next</a><% } %>
    </nav>
  </div>
</main>
<%- include('../partials/foot') %>
