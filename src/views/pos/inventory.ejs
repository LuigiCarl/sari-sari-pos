<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <h1>Inventory</h1>

  <div class="card">
    <h2>Submit Inventory Report</h2>
    <form method="POST" action="/pos/inventory/report" class="form-grid">
      <label>Product
        <select name="product_id" required>
          <% products.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.stock_quantity %> <%= p.unit %> in stock)</option>
          <% }) %>
        </select>
      </label>
      <label>Type
        <select name="type" required>
          <option value="restock">Restock (received new stock)</option>
          <option value="damaged">Damaged</option>
          <option value="lost">Lost / Missing</option>
          <option value="correction">Correction</option>
        </select>
      </label>
      <label>Quantity <input type="number" name="quantity" min="1" required /></label>
      <label>Correction direction<select name="direction"><option value="decrease">Decrease stock (correction only)</option><option value="increase">Increase stock (correction only)</option></select></label>
      <label>Note <input type="text" name="note" placeholder="Optional remarks" /></label>
      <button type="submit" class="btn btn-primary" <%= products.length ? '' : 'disabled' %>>Submit Report</button>
    </form>
    <% if (!products.length) { %><p class="muted">No products available. Ask your administrator to add products before submitting a report.</p><% } %>
  </div>

  <div class="card">
    <div class="section-heading"><h2>Current Stock</h2><input type="search" class="table-search" data-filter-table="stockTable" placeholder="Search stock..." /></div>
    <div class="table-scroll"><table class="table" id="stockTable">
      <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr class="<%= p.stock_quantity <= p.reorder_level ? 'row-warning' : '' %>" data-search="<%= p.name %>">
            <td><%= p.name %></td>
            <td><span class="stock-badge <%= p.stock_quantity === 0 ? 'stock-out' : (p.stock_quantity <= p.reorder_level ? 'stock-low' : 'stock-good') %>"><%= p.stock_quantity %> <%= p.unit %></span></td>
            <td><%= p.reorder_level %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (!products.length) { %><p class="muted">No stock to display yet.</p><% } %>
  </div>

  <div class="card">
    <h2>My Recent Reports</h2>
    <% if (myReports.length === 0) { %>
      <p class="muted">You haven't submitted any reports yet.</p>
    <% } else { %>
      <div class="table-scroll"><table class="table">
        <thead><tr><th>Product</th><th>Type</th><th>Change</th><th>Stock Before → After</th><th>Note</th><th>When</th></tr></thead>
        <tbody>
          <% myReports.forEach(r => { %>
            <tr>
              <td><%= r.product_name %></td>
              <td><%= r.type %></td>
              <td><%= r.quantity_change > 0 ? '+' : '' %><%= r.quantity_change %></td>
              <td><%= r.previous_stock == null ? 'Not recorded' : r.previous_stock + ' → ' + r.new_stock %></td>
              <td><%= r.note || '—' %></td>
              <td><%= new Date(r.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
