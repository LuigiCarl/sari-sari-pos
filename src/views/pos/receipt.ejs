<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container receipt-page">
  <div class="card receipt">
    <div class="receipt-brand"><strong>Sari-Sari POS</strong><h1>Sales Receipt</h1></div>
    <%- include('../partials/sale_status') %>
    <p><strong>Receipt No:</strong> <%= sale.receipt_no %></p>
    <p><strong>Date:</strong> <%= new Date(sale.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
    <table class="table">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.product_name %></td>
            <td><%= peso(i.unit_price) %></td>
            <td><%= i.quantity %></td>
            <td><%= peso(i.subtotal) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="receipt-grand-total"><td colspan="3">Total</td><td><%= peso(sale.total_amount) %></td></tr>
        <tr><td colspan="3">Amount Paid</td><td><%= peso(sale.amount_paid) %></td></tr>
        <tr><td colspan="3">Change</td><td><%= peso(sale.change_amount) %></td></tr>
      </tfoot>
    </table>
    <p class="receipt-thanks">Thank you for shopping with us!</p>
    <div class="receipt-actions">
      <button onclick="window.print()" class="btn btn-secondary">Print</button>
      <a href="/pos" class="btn btn-primary">New Sale</a>
      <a href="/pos/sales" class="btn btn-secondary">My Sales</a>
    </div>
  </div>
</main>
<script>
  try {
    const key = 'pos-draft-<%= currentUser.id %>';
    const draft = JSON.parse(sessionStorage.getItem(key) || 'null');
    if (draft && draft.token === '<%= sale.checkout_token || '' %>') sessionStorage.removeItem(key);
  } catch (_) {}
</script>
<%- include('../partials/foot') %>
